# Server-side only. Do not prefix these with VITE_ — that would expose them to the browser.
# On Vercel, set these same names as project Environment Variables (Production).

# auto = OpenRouter when OPENROUTER_API_KEY is set, otherwise the mock provider
AI_PROVIDER=auto

# OpenRouter (https://openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_REFERER=
OPENROUTER_TITLE=
